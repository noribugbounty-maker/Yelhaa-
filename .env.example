# Yelhaa — noms des variables uniquement. Aucune valeur réelle dans ce fichier.
# Copier en `.env.local` et renseigner. `.env.local` n'est jamais commité.
#
# Règle de lecture :
# - `NEXT_PUBLIC_*` est figé au build ET embarqué dans le bundle navigateur.
#   N'y mettre que ce qui peut être lu par n'importe qui.
# - Sans préfixe : serveur uniquement, relu à chaque requête. Secrets ici.

# =============================================================================
# 1. Site
# =============================================================================
# Origine publique, sans barre oblique finale. Vide en local : repli sur
# http://localhost:3000 (canoniques, Open Graph, redirections OAuth).
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# 2. Supabase — Dashboard → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alias serveur des deux valeurs ci-dessus — filet de sécurité pour
# l'hébergement. Next fige `NEXT_PUBLIC_*` au moment du build : sur Vercel,
# ajouter ces variables après coup n'a AUCUN effet tant qu'on n'a pas redéployé,
# le code compilé contient déjà `undefined`. Ces deux-ci ne sont pas préfixées,
# donc relues à chaque requête. Renseigner les deux paires évite le piège.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Clé `service_role` — contourne la RLS. Serveur uniquement, jamais NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Fournisseurs OAuth réellement activés dans Supabase, séparés par une virgule.
# Vide = seul le formulaire e-mail est proposé. Valeurs acceptées : google, github.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# =============================================================================
# 3. Administration — générations non comptées
# =============================================================================
# Liste d'adresses séparées par des virgules. Une adresse n'est pas un secret :
# rien de sensible n'entre ici, et rien n'entre dans le dépôt.
#
# **Pas de préfixe NEXT_PUBLIC** : le rôle est résolu côté serveur uniquement,
# à partir de la session validée par Supabase. Le navigateur ne peut ni le
# demander ni le deviner.
#
# Deux conditions sont exigées : l'adresse figure ici, ET elle a été confirmée
# côté Supabase Auth. Sans la seconde, quiconque créerait un compte avec cette
# adresse avant son propriétaire hériterait du rôle.
#
# Variable absente ou vide : personne n'est administrateur. Une erreur de
# configuration retire le privilège, elle ne l'accorde jamais.
ADMIN_EMAILS=

# =============================================================================
# 4. Stripe — Dashboard → Developers
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# Non lue par le code aujourd'hui ; réservée à Stripe.js côté client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# =============================================================================
# 5. Moteur IA — OpenAI (gpt-5-nano)
# =============================================================================
# Clé secrète. Serveur uniquement, jamais NEXT_PUBLIC. Obligatoire.
OPENAI_API_KEY=

# Modèle unique des trois étapes : classification, RAG/injection, chat.
# Sans cette valeur (ni override d'étape), le moteur refuse de démarrer.
OPENAI_MODEL=gpt-5-nano

# Overrides optionnels. Vides : OPENAI_MODEL s'applique partout.
OPENAI_MODEL_CLASSIFY=
OPENAI_MODEL_INJECT=
OPENAI_MODEL_CHAT=

# Plafond de sortie, en jetons (`max_completion_tokens` côté GPT-5).
# Vide ou illisible : 6 000. Ne pas descendre sous 4 000 sans remesurer.
OPENAI_MAX_OUTPUT_TOKENS=

# =============================================================================
# 6. Éditeur — immatriculation et coordonnées (pages /legal/*)
# =============================================================================
# Serveur uniquement (pas de NEXT_PUBLIC) : rendues dans les pages légales,
# jamais dans un bundle client. Aucune coordonnée ne vit dans le code : un
# champ vide s'affiche « to be completed before launch » plutôt que d'être
# masqué ou inventé.
LEGAL_SIREN=
LEGAL_SIRET=
LEGAL_CAPITAL=
LEGAL_ADDRESS=
# Format international (+33 …) : la page est en anglais et lue depuis l'étranger.
LEGAL_PHONE=
LEGAL_EMAIL=
# Directeur de la publication et représentant légal, avec leur qualité.
LEGAL_PUBLISHER=
LEGAL_REPRESENTATIVE=
# TVA intracommunautaire — se dérive du SIREN, vérifiable sur VIES.
# Laisser vide si la société n'est pas assujettie.
LEGAL_VAT=
# Médiateur de la consommation auquel la société ADHÈRE (L616-1 C. conso).
# Vide tant qu'aucun contrat d'adhésion n'est signé.
LEGAL_MEDIATOR=

# =============================================================================
# 7. Contacts publics — footer et page /contact (build prompt §8)
# =============================================================================
# Embarqués dans le bundle : uniquement des adresses destinées à être publiques.
# Laisser vide tant que les comptes ne sont pas ouverts : une icône sans URL
# n'est pas rendue — jamais de lien mort.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_URL_X=
NEXT_PUBLIC_URL_GITHUB=
NEXT_PUBLIC_URL_DISCORD=
NEXT_PUBLIC_URL_LINKEDIN=
NEXT_PUBLIC_URL_INSTAGRAM=
NEXT_PUBLIC_URL_TIKTOK=

